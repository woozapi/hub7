# ================================================================================
# Environment Variables - Configure antes do deploy
# ================================================================================

# Supabase (obrigatório)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key

# Gemini AI (opcional)
GEMINI_API_KEY=

# ================================================================================
# PRODUCTION - Configure no dashboard do Fly.io
# ================================================================================

NODE_ENV=production
PORT=8080
ALLOWED_ORIGINS=https://sua-app.vercel.app
